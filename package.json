{
  "name": "vital-fitness-app",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch --clear-screen=false server/src/index.ts",
    "dev:coach": "tsx watch --clear-screen=false server/src/coach-index.ts",
    "build": "npm run build:server && vite build",
    "build:frontend": "vite build",
    "build:server": "npm run db:generate && tsc -p server/tsconfig.json",
    "start:server": "node server/dist/index.js",
    "start:coach": "node server/dist/coach-index.js",
    "db:generate": "prisma generate --config server/prisma.config.ts",
    "db:migrate:dev": "prisma migrate dev --config server/prisma.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config server/prisma.config.ts",
    "db:seed": "prisma db seed --config server/prisma.config.ts",
    "test": "vitest run",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "framer-motion": "^14.0.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true
  }
}
